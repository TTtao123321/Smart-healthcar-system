# ===== LLM 配置(必填)=====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ===== HMS 管理员账号(供 Agent 后端调用)=====
HMS_ADMIN_USERNAME=admin
HMS_ADMIN_PASSWORD=admin123

# ===== Docker 镜像源(可选)=====
# 默认走 docker.io 上游。国内网络下载慢时可填入轩辕/阿里云等镜像加速专属域,例如:
#   REGISTRY_PREFIX=your-prefix.xuanyuan.run/library
#   REGISTRY_MINIO_PREFIX=your-prefix.xuanyuan.run/minio
# 留空使用 docker.io 默认
REGISTRY_PREFIX=
REGISTRY_MINIO_PREFIX=

# ===== 构建时镜像源(可选,加速 Maven/pip/apt)=====
# 留空使用官方源;国内可填:
#   MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   DEBIAN_MIRROR_URL=https://mirrors.aliyun.com
MAVEN_MIRROR_URL=
PIP_INDEX_URL=
DEBIAN_MIRROR_URL=
